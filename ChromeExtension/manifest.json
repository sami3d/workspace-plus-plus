{
  "manifest_version": 3,
  "name": "Workspace++ Chrome Companion",
  "version": "1.0.0",
  "description": "Saves and restores Chrome windows, tabs, pinned tabs, and tab groups with Workspace++.",
  "key": "",
  "permissions": ["tabs", "tabGroups", "nativeMessaging", "alarms"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Save Chrome state to Workspace++"
  }
}

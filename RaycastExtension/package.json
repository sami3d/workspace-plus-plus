{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "workspace-plus-plus",
  "title": "Workspace++ Space Switcher",
  "description": "Search live Workspace++ space names and switch instantly.",
  "icon": "command-icon.png",
  "author": "syedsami",
  "categories": [
    "Productivity",
    "System"
  ],
  "license": "MIT",
  "platforms": [
    "macOS"
  ],
  "commands": [
    {
      "name": "switch-space",
      "title": "Switch Space",
      "subtitle": "Workspace++",
      "description": "Search current Workspace++ spaces and switch to one.",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.19"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.1.1",
    "@types/node": "^25.0.0",
    "@types/react": "^19.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "publish": "npx @raycast/api@latest publish",
    "lint": "eslint src && prettier --check .",
    "fix-lint": "eslint src --fix && prettier --write ."
  }
}
